spring.application.name=demo

# Server Configuration (Changed from default 8080 to 8081 for API Gateway)
server.port=8081

# PostgreSQL Connection Settings
spring.datasource.url=jdbc:postgresql://localhost:5432/your_db_here
spring.datasource.username=your_db_username_here
spring.datasource.password=your_db_password_here
spring.datasource.driver-class-name=org.postgresql.Driver

# Read scaling (optional): configure read replica URL.
# Leave READ_DATASOURCE_URL empty to use primary for reads.
spring.datasource.write.url=${spring.datasource.url}
spring.datasource.write.username=${spring.datasource.username}
spring.datasource.write.password=${spring.datasource.password}
spring.datasource.write.driver-class-name=${spring.datasource.driver-class-name}

spring.datasource.read.url=${READ_DATASOURCE_URL:}
spring.datasource.read.username=${READ_DATASOURCE_USERNAME:${spring.datasource.username}}
spring.datasource.read.password=${READ_DATASOURCE_PASSWORD:${spring.datasource.password}}
spring.datasource.read.driver-class-name=${READ_DATASOURCE_DRIVER:${spring.datasource.driver-class-name}}

# Valkey/Redis Connection Settings
spring.data.redis.host=your_valkey_host_here
spring.data.redis.port=6378

# Authentication
# For username + password authentication (Valkey/Redis 6.0+ ACL):
spring.data.redis.username=your_username_here
spring.data.redis.password=your_password_here

# Optional Connection Settings
spring.data.redis.timeout=60000
spring.data.redis.database=0
spring.data.redis.ssl.enabled=false

# Spring Cache Configuration (using Valkey as backend)
# Valkey is Redis-compatible, so we use spring.cache.type=redis
spring.cache.type=redis
spring.cache.redis.time-to-live=600000
spring.cache.redis.cache-null-values=false

# Swagger/OpenAPI Configuration
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.swagger-ui.operationsSorter=method
springdoc.swagger-ui.tagsSorter=alpha

# Logging Configuration
logging.level.root=INFO
logging.level.com.example.demo=DEBUG
logging.level.org.springframework.data.redis=DEBUG
logging.pattern.console=%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
logging.file.name=logs/application.log

# QR Code Configuration
# Base URL for QR code redirects (used in generated QR codes)
app.base-url=http://localhost:8081
# Short code length for QR code URLs (6-8 recommended)
# 6 chars = 56B combinations (good for < 100K codes)
# 7 chars = 3.5T combinations (good for < 10M codes)
# 8 chars = 218T combinations (good for any scale)
app.qrcode.shortcode-length=6
